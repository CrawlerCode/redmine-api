{
  "name": "redmine-api-monorepo",
  "description": "Redmine API Monorepo",
  "version": "0.0.0",
  "author": "CrawlerCode",
  "keywords": [],
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter dev run dev",
    "spec:compile:watch": "pnpm --filter spec run compile:watch",
    "spec:compile": "pnpm --filter spec run compile",
    "client:build": "pnpm --filter redmine-api-client run build",
    "build": "pnpm spec:compile && pnpm client:build",
    "test": "pnpm --filter tests run test"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "@types/node": "^24.19.2"
  }
}
