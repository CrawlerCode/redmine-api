{
  "name": "redmine-api-monorepo",
  "description": "Redmine API Monorepo",
  "version": "0.2.0-beta.2",
  "author": "CrawlerCode",
  "keywords": [],
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "pnpm --filter dev run dev",
    "spec:compile:watch": "pnpm --filter spec run compile:watch",
    "spec:compile": "pnpm --filter spec run compile",
    "build:packages": "pnpm --filter \"{./packages/*}...\" run build",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "build": "pnpm spec:compile && pnpm build:packages",
    "test": "pnpm --filter tests run test",
    "test:packages": "pnpm --filter \"./packages/*\" run typecheck && pnpm --filter \"./packages/*\" run test",
    "format": "prettier --write .",
    "version:packages": "pnpm -r --filter . --filter spec --filter \"./packages/*\" version",
    "publish:packages": "pnpm --filter \"./packages/*\" publish --access public --no-git-checks",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@typespec/prettier-plugin-typespec": "1.17.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "prettier": "^3.9.10",
    "semantic-release": "25.0.9",
    "typescript": "catalog:"
  }
}
